name "thumbelina"
description "Thumbelina — multiboot USB orchestrator: live ISOs, thin Btrfs installs, or both."
authors "AMDphreak"
license "MIT"
copyright "Copyright © 2026, Desktop-Tooling"
homepage "https://github.com/Desktop-Tooling/Thumbelina"

targetType "library"
targetPath "bin"
targetName "thumbelina"
sourcePaths "source/lib"
importPaths "source/lib"
stringImportPaths "service-payload" "scripts"

configuration "library" {
}

configuration "application" {
    targetType "executable"
    targetName "thumbelina"
    mainSourceFile "source/cli/app.d"
    sourceFiles "source/cli/app.d"
    versions "ThumbelinaCli"
}

configuration "tina" {
    targetType "executable"
    targetName "tina"
    mainSourceFile "source/cli/app.d"
    sourceFiles "source/cli/app.d"
    versions "ThumbelinaCli"
}

configuration "gui" {
    targetType "executable"
    targetName "thumbelina-gui"
    mainSourceFile "source/gui/app.d"
    sourceFiles "source/gui/app.d"
    versions "ThumbelinaGui"
    dependency "dlangui" version="~>0.9.186"
}

configuration "unittest" {
    targetType "executable"
    targetName "thumbelina-test"
    mainSourceFile "tests/runner.d"
    sourceFiles "tests/runner.d"
}
