# Allow-list: ignore everything, then un-ignore tracked paths.
*
!/.gitignore
!/LICENSE
!/README.md
!/AGENTS.md
!/CHANGELOG.md
!/dub.sdl
!/dub.selections.json

!/source/
!/source/**
!/tests/
!/tests/**
!/scripts/
!/scripts/**
!/service-payload/
!/service-payload/**
!/docs/
!/docs/**
!/changelog/
!/changelog/**
!/changelog-details/
!/changelog-details/**
!/demos/
!/demos/**
!/.github/
!/.github/**

# Never track build / local secrets
bin/
.dub/
*.obj
*.o
*.exe
*.pdb
*.lib
*.exp
*.dll
MEMORIES.md
machine.md
.env
.env.*
*.local.ps1
